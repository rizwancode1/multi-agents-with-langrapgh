# .env
# LLM (OpenRouter)
OPEN_ROUTER_API_KEY=sk-your-key-here
PRIMARY_MODEL=openrouter/google/gemini-2.0-flash-exp:free
FALLBACK_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Optional shared API key. When set, mutating endpoints require "X-API-Key" header.
API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_your-key-here
LANGSMITH_PROJECT=production-api

APP_ENV=development
LOG_LEVEL=INFO
RATE_LIMIT=20/minute
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
INGEST_ON_STARTUP=true
# Draw the mermaid graph PNG on startup (slow; needs network). Off by default.
DEBUG_DRAW_GRAPH=false

# Cache backend: auto (redis in production, memory in dev) | memory | redis
CACHE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0

# Database (PostgreSQL in production; also used by PGVector when enabled)
DATABASE_URL=sqlite:///./orders.db
# Echo all SQL statements to the console (noisy; useful for debugging)
DB_ECHO_LOGS=false

# Vector store: opt-in PGVector for embeddings storage (independent of main DB choice)
USE_PGVECTOR=false
PGVECTOR_COLLECTION=policy_docs

# RAG settings
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
MAX_RETRIEVAL_RETRIES=1
